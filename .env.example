# ── Core ───────────────────────────────────────────────────────────────
# Public URL of the app (no trailing slash). Used for auth callbacks, emails and Stripe redirects.
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas?schema=public"
# Connections per server instance. Use 1 with `npx prisma dev` (its local Postgres is single-connection).
DATABASE_POOL_MAX="5"
# Optional: a separate, disposable database for `npm test` integration tests (they wipe it).
TEST_DATABASE_URL=""

# ── Auth (Better Auth) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32+-character-random-secret"
# Set to "true" in production once an email provider is configured.
REQUIRE_EMAIL_VERIFICATION="false"

# Optional OAuth providers (buttons appear automatically when both values are set)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Public demo ────────────────────────────────────────────────────────
# "true" adds a "Try the demo" button, makes the seeded demo workspace and accounts
# read-only, and lets /api/cron/reset-demo (called with CRON_SECRET) rebuild it nightly.
DEMO_MODE="false"
CRON_SECRET=""

# ── Email ──────────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Acme <noreply@example.com>"

# ── Billing (Stripe) ───────────────────────────────────────────────────
# Billing is disabled until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""
